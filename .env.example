# Copy to .env and fill in. Never commit .env — it is in .gitignore.

# ---------------------------------------------------------------------------
# Database: two roles, on purpose
# ---------------------------------------------------------------------------
# The application connects as a restricted role. It must NOT be a superuser and
# must NOT own the tables: PostgreSQL superusers bypass Row-Level Security
# unconditionally, and table owners bypass it unless the table is FORCEd. An app
# that connects as `postgres` has policies that do nothing at all.
#
# Create this role with:  python scripts/setup_db_role.py
# (run it after `alembic upgrade head`; it reads both URLs from this file)
DATABASE_URL=postgresql://saas_app:CHANGE_ME@localhost:5432/saas_project

# Schema-owning role. Alembic uses this; the application never does. Keeping the
# two apart is what stops the application from being able to alter the schema or
# switch the isolation policies off.
# Omit this and everything falls back to DATABASE_URL — simpler, but then the
# app role needs DDL rights and scripts/setup_db_role.py will refuse to run.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/saas_project

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a fresh one per environment, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every token already issued.
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Frontend (saas-frontend reads this; the backend ignores it)
# ---------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api/v1

# ---------------------------------------------------------------------------
# Tests (optional)
# ---------------------------------------------------------------------------
# tests/conftest.py derives its databases by appending `_test` to the two URLs
# above and creates them on first run. Set these only to point somewhere else.
# The suite refuses to start if a test URL resolves to a development database,
# or if the app and admin roles turn out to be the same.
# TEST_DATABASE_URL=postgresql://saas_app:CHANGE_ME@localhost:5432/saas_project_test
# TEST_MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/saas_project_test
